#!/bin/bash
# aculos-flatpak: installs the Flatpak apps listed in ~/.config/aculos/flatpak.list (one Flathub app ID per line,
# "#" for comments) that are not installed yet. Apps that are installed but not in the list are only reported,
# never removed. Apps are installed system-wide from Flathub.
# Usage: aculos-flatpak [--check]     --check only shows what would be done
set -euo pipefail
list="${XDG_CONFIG_HOME:-$HOME/.config}/aculos/flatpak.list"
[ -r "$list" ] || { echo "aculos-flatpak: missing $list (one Flathub app ID per line)" >&2; exit 1; }
check=0; [ "${1:-}" = "--check" ] && check=1
mapfile -t wanted < <(sed -e 's/#.*//' -e 's/[[:space:]]//g' "$list" | grep -v '^$' | sort -u)
mapfile -t installed < <(flatpak list --app --columns=application 2>/dev/null | sort -u)
missing=(); extra=()
for a in "${wanted[@]}"; do printf '%s\n' "${installed[@]}" | grep -qx "$a" || missing+=("$a"); done
for a in "${installed[@]}"; do [ -n "$a" ] || continue; printf '%s\n' "${wanted[@]}" | grep -qx "$a" || extra+=("$a"); done
echo "In the list: ${#wanted[@]}; to install: ${#missing[@]}; installed but not in the list: ${#extra[@]}"
[ ${#extra[@]} -eq 0 ] || printf '  not in the list: %s\n' "${extra[@]}"
[ ${#missing[@]} -gt 0 ] || exit 0
printf '  to install: %s\n' "${missing[@]}"
[ $check -eq 0 ] || exit 0
flatpak install --system --noninteractive -y flathub "${missing[@]}"
