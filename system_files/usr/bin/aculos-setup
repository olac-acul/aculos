#!/bin/bash
# aculos-setup: first-login setup of a new aculOs machine, step by step. Every step is skipped when already done,
# so it can be run again after an interruption.
#   1. network: if the password vault is not reachable, offer to join a Tailscale/Headscale network;
#   2. Bitwarden desktop (in the image): wait until you log in and turn on its SSH agent;
#   3. Bitwarden CLI (bw): point it at the vault and log in;
#   4. dotfiles: chezmoi init --apply from your repository, cloned over SSH with the key served by Bitwarden;
#   5. Flatpak apps listed by the dotfiles (aculos-flatpak);
#   6. what is left to do by hand.
# Nothing personal is built in: addresses are asked once and kept in ~/.local/state/aculos/setup.env.
#
# At login it also sets a stock wallpaper on an account that has none.
#
# Usage: aculos-setup             run the setup
#        aculos-setup --welcome   at login: open it in a terminal, unless already done or declined
set -uo pipefail

state="${XDG_STATE_HOME:-$HOME/.local/state}/aculos"
answers="$state/setup.env"
done_stamp="$state/setup-done"
agent="$HOME/.bitwarden-ssh-agent.sock"   # Bitwarden desktop's SSH agent

default_wallpaper() {   # a fresh account has none: set a stock one, until a theme or the user picks another
    local current="" file
    command -v noctalia >/dev/null || return 0
    for _ in $(seq 20); do   # at login Noctalia may still be starting
        current=$(noctalia msg wallpaper-get 2>/dev/null) && break
        sleep 0.5
    done
    current=$(tail -n 1 <<<"$current")
    [ -n "$current" ] && [ -f "$current" ] && return 0
    for file in /usr/share/backgrounds/aculos/* /usr/share/backgrounds/fedora-workstation/*_dark.*; do
        [ -f "$file" ] && { noctalia msg wallpaper-set "$file" >/dev/null 2>&1; return 0; }
    done
}

if [ "${1:-}" = "--welcome" ]; then
    default_wallpaper
    [ -e "$done_stamp" ] || [ -d "${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi" ] && exit 0
    exec kitty --title "aculOs setup" aculos-setup
fi

bold=$'\e[1m'; dim=$'\e[2m'; off=$'\e[0m'
step() { printf '\n%s== %s%s\n' "$bold" "$*" "$off"; }
note() { printf '%s%s%s\n' "$dim" "$*" "$off"; }
ask() {   # ask VAR "question" [default]
    local reply
    read -r -p "$2${3:+ [$3]}: " reply
    printf -v "$1" '%s' "${reply:-${3:-}}"
}
yes_no() { local r; read -r -p "$1 [y/N] " r; [[ $r == [yY]* ]]; }
remember() { mkdir -p "$state"; grep -v "^$1=" "$answers" 2>/dev/null >"$answers.new"; printf '%s=%q\n' "$1" "$2" >>"$answers.new"; mv "$answers.new" "$answers"; }

# shellcheck disable=SC1090
[ -r "$answers" ] && . "$answers"
VAULT_URL="${VAULT_URL:-}"; DOTFILES_REPO="${DOTFILES_REPO:-}"; HEADSCALE_URL="${HEADSCALE_URL:-}"

printf '%sWelcome to aculOs.%s This sets up your account: password vault, SSH keys, dotfiles and apps.\n' "$bold" "$off"
note "Each step is skipped when already done; you can stop with Ctrl+C and run aculos-setup again later."
if ! yes_no "Start now?"; then
    if yes_no "Do not ask again at login?"; then mkdir -p "$state"; touch "$done_stamp"; fi
    exit 0
fi

step "1. Network and password vault"
[ -n "$VAULT_URL" ] || { ask VAULT_URL "Vaultwarden/Bitwarden server URL (e.g. https://vault.example.org)"; remember VAULT_URL "$VAULT_URL"; }
until curl -fsS -m 5 -o /dev/null "$VAULT_URL/alive" 2>/dev/null || curl -fsS -m 5 -o /dev/null "$VAULT_URL" 2>/dev/null; do
    echo "The vault at $VAULT_URL is not reachable from here."
    if tailscale status >/dev/null 2>&1; then
        note "Tailscale is already connected: check the address, or the network you are on."
    elif yes_no "Join a Tailscale/Headscale network now?"; then
        [ -n "$HEADSCALE_URL" ] || { ask HEADSCALE_URL "Login server (empty for tailscale.com)"; remember HEADSCALE_URL "$HEADSCALE_URL"; }
        sudo tailscale up --accept-routes --operator="$USER" ${HEADSCALE_URL:+--login-server="$HEADSCALE_URL"}
        continue
    fi
    yes_no "Try again?" || exit 1
done
echo "Vault reachable."

step "2. Bitwarden and its SSH agent"
until [ -S "$agent" ] && SSH_AUTH_SOCK="$agent" ssh-add -l >/dev/null 2>&1; do
    # in its own session: closing this terminal must not close Bitwarden (and its SSH agent) too
    pgrep -f /usr/lib/Bitwarden/ >/dev/null || setsid -f bitwarden </dev/null >/dev/null 2>&1
    echo "In the Bitwarden window: choose \"self-hosted\" as the server ($VAULT_URL) and log in,"
    echo "then in Settings turn on \"Enable SSH agent\"."
    read -r -p "Press Enter when done... " _
done
echo "Keys served by Bitwarden:"; SSH_AUTH_SOCK="$agent" ssh-add -l

step "3. Bitwarden CLI"
if [ "$(bw status 2>/dev/null | jq -r .status)" = "unauthenticated" ]; then
    bw config server "$VAULT_URL" >/dev/null
    until bw login; do yes_no "Login failed. Try again?" || exit 1; done
else
    echo "bw is already logged in."
fi

step "4. Dotfiles (chezmoi)"
# a clone, not just the folder: "chezmoi git" and others create it empty
if [ -d "$(chezmoi source-path 2>/dev/null)/.git" ]; then
    echo "Dotfiles already initialized: updating."
    chezmoi update
else
    [ -n "$DOTFILES_REPO" ] || { ask DOTFILES_REPO "Dotfiles repository (git URL, e.g. git@host:user/dotfiles.git)"; remember DOTFILES_REPO "$DOTFILES_REPO"; }
    note "The first SSH connection to the repository host asks you to confirm its key."
    note "chezmoi asks for the vault master password to read the secrets, sudo for system files, and Bitwarden"
    note "asks you to authorize the use of an SSH key."
    until SSH_AUTH_SOCK="$agent" chezmoi init --apply "$DOTFILES_REPO"; do
        yes_no "chezmoi failed. Try again?" || exit 1
    done
fi

step "5. Flatpak apps"
if [ -r "${XDG_CONFIG_HOME:-$HOME/.config}/aculos/flatpak.list" ]; then
    aculos-flatpak || note "Some apps were not installed: run aculos-flatpak again later."
else
    note "No ~/.config/aculos/flatpak.list in the dotfiles: nothing to install."
fi

mkdir -p "$state"; touch "$done_stamp"
step "Done. Left to do by hand"
cat <<'EOF'
- Log out and back in, so that the session uses the configuration that just arrived.
- Browser extensions install themselves on first start (Pywalfox and Bitwarden in Firefox and LibreWolf,
  Bitwarden in Chromium): just log in to Bitwarden in each browser.
- In Bitwarden desktop, Settings: "Keep Bitwarden running in the background" and "Start automatically on login",
  so that it (and the SSH agent) keeps running in the tray without a window; "Unlock with system authentication"
  for the fingerprint, with vault timeout action "Lock" and a timeout in minutes (not "On restart"): the key for
  it lives only in memory, so after a login the first unlock always takes the master password. The browser
  extensions unlock through the desktop app ("Unlock with biometrics" in the extension).
- Anything listed under "by hand" in your dotfiles' README (Wi-Fi zones, Tailscale, ...).
EOF
read -r -p "Press Enter to close. " _
