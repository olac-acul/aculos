#!/usr/bin/python3 -I
"""Stacca il lettore di impronte a coperchio chiuso e lo riattacca all'apertura.

A coperchio chiuso il lettore non si può usare: staccandolo (authorized=0 sul dispositivo USB) fprintd non lo
vede più, e sudo, polkit e il blocco schermo passano subito alla password invece di aspettare il dito.
I lettori si riconoscono dall'elenco dei dispositivi USB di libfprint (il suo hwdb), il coperchio dal
dispositivo di input "Lid Switch". Senza coperchio il programma esce senza fare niente; i lettori li cerca a ogni
apertura e chiusura, così vale anche per un lettore comparso dopo l'avvio.

Uso: impronta-coperchio            servizio (aculos-impronta-coperchio.service)
     impronta-coperchio --prova    mostra lettori e stato del coperchio, senza cambiare niente
"""
import fcntl
import glob
import os
import re
import signal
import struct
import sys

EV_SW, SW_LID = 0x05, 0x00
EVENTO = struct.Struct("llHHi")  # struct input_event (64 bit)
EVIOCGSW = (2 << 30) | (8 << 16) | (ord("E") << 8) | 0x1B  # stato degli interruttori, buffer da 8 byte


def id_lettori():
    ids = set()
    for f in glob.glob("/usr/lib/udev/hwdb.d/*libfprint*.hwdb"):
        with open(f) as h:
            for riga in h:
                m = re.match(r"usb:v([0-9A-Fa-f]{4})p([0-9A-Fa-f]{4})\*", riga.strip())
                if m:
                    ids.add((m[1].lower(), m[2].lower()))
    return ids


def lettori(ids):
    trovati = []
    for d in glob.glob("/sys/bus/usb/devices/*"):
        try:
            with open(d + "/idVendor") as v, open(d + "/idProduct") as p:
                if (v.read().strip(), p.read().strip()) in ids:
                    trovati.append(d)
        except OSError:
            pass
    return trovati


def coperchio():
    for d in glob.glob("/sys/class/input/event*"):
        try:
            with open(d + "/device/name") as n:
                if n.read().strip() == "Lid Switch":
                    return "/dev/input/" + os.path.basename(d)
        except OSError:
            pass
    return None


def chiuso(fd):
    buf = bytearray(8)
    fcntl.ioctl(fd, EVIOCGSW, buf)
    return bool(buf[0] & (1 << SW_LID))


def imposta(ids, attivo):
    for d in lettori(ids):
        try:
            with open(d + "/authorized", "w") as a:
                a.write("1" if attivo else "0")
            print(f"{d}: {'riattaccato' if attivo else 'staccato'}", flush=True)
        except OSError as e:
            print(f"{d}: {e}", file=sys.stderr, flush=True)


def main():
    prova = "--prova" in sys.argv[1:]
    ids = id_lettori()
    ev = coperchio()
    if prova:
        print("modelli noti a libfprint:", len(ids))
        print("lettori:", lettori(ids) or "nessuno")
        print("coperchio:", ev or "nessuno")
    if not ev:
        if not prova:
            print("Niente coperchio: esco.", flush=True)
        return 0
    fd = os.open(ev, os.O_RDONLY)
    stato = chiuso(fd)
    if prova:
        print("stato:", "chiuso" if stato else "aperto")
        return 0

    # All'uscita il lettore torna sempre attaccato
    def esci(*_):
        imposta(ids, True)
        sys.exit(0)

    signal.signal(signal.SIGTERM, esci)
    signal.signal(signal.SIGINT, esci)
    imposta(ids, not stato)
    while True:
        dati = os.read(fd, EVENTO.size * 64)
        for i in range(0, len(dati) - EVENTO.size + 1, EVENTO.size):
            _, _, tipo, codice, valore = EVENTO.unpack_from(dati, i)
            if tipo == EV_SW and codice == SW_LID:
                imposta(ids, valore == 0)


if __name__ == "__main__":
    sys.exit(main())
