[Unit]
Description=Desktop notifications from an ntfy channel (aculos-ntfy)
After=graphical-session.target
PartOf=graphical-session.target
ConditionPathExists=%h/.config/aculos/ntfy.conf

[Service]
ExecStart=/usr/bin/aculos-ntfy
Restart=always
RestartSec=10

[Install]
WantedBy=graphical-session.target
