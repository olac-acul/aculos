[Unit]
Description=Receives files sent with Taildrop (aculos-receive)
ConditionPathExists=%h/.config/aculos/receive.conf

[Service]
ExecStart=/usr/bin/aculos-receive
Restart=always
RestartSec=10
# 3: not the Tailscale operator (see aculos-receive), retrying does not help
RestartPreventExitStatus=3

[Install]
WantedBy=default.target
