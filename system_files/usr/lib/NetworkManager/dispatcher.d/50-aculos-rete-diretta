#!/bin/sh
# Rete diretta: quando il portatile è collegato a una delle reti scritte in /etc/aculos/rete-diretta.conf (righe
# RETE=indirizzo/prefisso, per esempio la rete di casa), il traffico verso quella rete esce dalla rete locale anche
# con Tailscale acceso (che con --accept-routes la manderebbe nella VPN, tabella 52, regola 5270). La regola ip
# (priorità 5200) viene prima; fuori da quella rete si toglie. NetworkManager lancia lo script a ogni cambio di rete.
conf=/etc/aculos/rete-diretta.conf
[ -r "$conf" ] || exit 0
case "$2" in up|down|dhcp4-change|connectivity-change|reapply) ;; *) exit 0 ;; esac
sed -n 's/^RETE=//p' "$conf" | while read -r rete; do
  [ -n "$rete" ] || continue
  if ip -4 route show table main exact "$rete" proto kernel | grep -q -v -E 'dev (tailscale|virbr|docker)'; then
    ip rule show | grep -q "to $rete lookup main" || ip rule add to "$rete" lookup main priority 5200
  else
    while ip rule del to "$rete" lookup main priority 5200 2>/dev/null; do :; done
  fi
done
