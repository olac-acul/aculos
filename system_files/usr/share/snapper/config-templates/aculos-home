# aculOs: snapper template for /var/home (used by aculos-snapper-home.service at the first boot).
# A snapshot every hour, kept for 3 days, plus one a day for a week. Users in wheel can list snapshots and
# restore files without sudo ("snapper -c home list", or browse /var/home/.snapshots/<n>/snapshot).
# Caches and containers are separate subvolumes (aculos-subvolumes.conf in user-tmpfiles.d), so they are not in
# the snapshots.
SUBVOLUME="/var/home"
FSTYPE="btrfs"
QGROUP=""
SPACE_LIMIT="0.5"
FREE_LIMIT="0.2"
ALLOW_USERS=""
ALLOW_GROUPS="wheel"
SYNC_ACL="yes"
BACKGROUND_COMPARISON="no"
NUMBER_CLEANUP="yes"
NUMBER_MIN_AGE="3600"
NUMBER_LIMIT="10"
NUMBER_LIMIT_IMPORTANT="5"
TIMELINE_CREATE="yes"
TIMELINE_CLEANUP="yes"
TIMELINE_MIN_AGE="3600"
TIMELINE_LIMIT_HOURLY="72"
TIMELINE_LIMIT_DAILY="7"
TIMELINE_LIMIT_WEEKLY="0"
TIMELINE_LIMIT_MONTHLY="0"
TIMELINE_LIMIT_QUARTERLY="0"
TIMELINE_LIMIT_YEARLY="0"
EMPTY_PRE_POST_CLEANUP="yes"
EMPTY_PRE_POST_MIN_AGE="3600"
