# Parametri della build (letti dal Justfile)

# Nome dell'immagine, uguale al nome del repo
IMAGE_NAME=aculos

# Account GitHub che pubblica l'immagine
REPO_ORGANIZATION="olac-acul"

IMAGE_DESC="aculOs: immagine bootc personale basata su Universal Blue (Fedora, niri, Noctalia)"
IMAGE_KEYWORDS="bootc,oci,linux,fedora,niri,noctalia"

IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
