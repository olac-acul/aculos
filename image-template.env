# Build parameters (read by the Justfile)

# Image name, same as the repo name
IMAGE_NAME=aculos

# GitHub account that publishes the image
REPO_ORGANIZATION="olac-acul"

IMAGE_DESC="aculOs: personal bootc image based on Universal Blue (Fedora, niri, Noctalia)"
IMAGE_KEYWORDS="bootc,oci,linux,fedora,niri,noctalia"

IMAGE_LOGO_URL="https://raw.githubusercontent.com/olac-acul/aculos/main/system_files/usr/share/aculos/logo/aculos-logo-square.png"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
